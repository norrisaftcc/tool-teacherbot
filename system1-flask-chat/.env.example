# Required. create_app() raises at startup if FLASK_SECRET_KEY or
# ADMIN_PASSWORD is missing — there are deliberately no fallbacks, because
# the old ones ('dev-secret', 'admin') are published in this public repo.
ANTHROPIC_API_KEY=sk-ant-your-key-here
FLASK_SECRET_KEY=run-python3-c-import-secrets-print-secrets-token_hex-32
ADMIN_PASSWORD=choose-something
DATABASE_URL=sqlite:///ta_system.db

# Optional.
# CSC134_PASSCODE=override-the-cohort-passcode-without-a-public-commit
# CSC134_ACTIVE_MODULE=m0
# GROUP_TOKEN_BUDGET=25000000
